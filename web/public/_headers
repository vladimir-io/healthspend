/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob: https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://huggingface.co https://*.huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co https://static.cloudflareinsights.com; img-src 'self' data: https://huggingface.co https://*.huggingface.co; frame-ancestors 'none'

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/api/v1/*.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Essential for sql.js-httpvfs range requests (local preview / accidental origin copies)
/*.db
  Accept-Ranges: bytes
  Access-Control-Expose-Headers: Content-Range, Content-Length
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: Range
  Cache-Control: public, max-age=3600, no-transform

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
