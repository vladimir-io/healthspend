# Hugging Face write token for scripts/deploy_huggingface.py (do not commit real values).
# HF=

# Optional: force hot shard in local dev (npm run dev).
# VITE_USE_HOT_DB=true

# Hugging Face-hosted SQLite shards (production uses hot first, full fallback).
# VITE_HOT_DB_URL=https://huggingface.co/datasets/vladimir-io/healthspend-data/resolve/main/audit_hot.db

# Browser SQLite VFS adapter.
VITE_DB_VFS=sqljs-httpvfs
