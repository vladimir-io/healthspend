# Cloudflare Pages deploy (needs Cloudflare Pages → Edit permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: skip zone lookup for WAF apply
CLOUDFLARE_ZONE_ID=
# Read-only token for analytics scripts (zone analytics + KV read)
CLOUDFLARE_API_TOKEN_READ_ONLY=

# App data source (hot shard is default; set VITE_USE_FULL_DB=true for full ledger in dev)
VITE_DB_VFS=sqljs-httpvfs
